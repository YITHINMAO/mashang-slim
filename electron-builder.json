{
  "appId": "local.mashang.slim",
  "productName": "码上瘦身",
  "directories": {
    "output": "release"
  },
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "files": [
    "src/**/*",
    "assets/**/*",
    "package.json"
  ],
  "icon": "assets/icon.png",
  "mac": {
    "category": "public.app-category.video",
    "icon": "assets/icon.icns",
    "extraResources": [
      {
        "from": "vendor/ffmpeg/darwin-arm64",
        "to": "ffmpeg/darwin-arm64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "target": [
      "dmg"
    ]
  },
  "win": {
    "icon": "assets/icon.ico",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "vendor/ffmpeg/win32-x64",
        "to": "ffmpeg/win32-x64",
        "filter": [
          "**/*"
        ]
      }
    ],
    "target": [
      "nsis",
      "portable"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "码上瘦身"
  }
}
